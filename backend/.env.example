# ============================================================
# ATLAS backend — configuración de entorno
# Copia este archivo a ".env" en la misma carpeta y completa
# los valores. NUNCA subas ".env" al repositorio.
# ============================================================

# Entorno de la app: development | production
APP_ENV=development

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Base de datos ---
# V1 usa SQLite por defecto (cero configuración). Para migrar a
# PostgreSQL más adelante, cambia esta URL, ej:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/atlas
DATABASE_URL=sqlite:///./atlas.db

# --- Redis (reservado, no usado todavía en V1) ---
# Se activará cuando el sistema necesite sesiones/caché/tareas/eventos.
REDIS_URL=redis://localhost:6379/0

# --- Proveedor de IA ---
# anthropic | mock
# "mock" permite correr y probar ATLAS sin gastar créditos ni tener API key.
AI_PROVIDER=mock

# Key de Anthropic (solo necesaria si AI_PROVIDER=anthropic).
# En V1 es una sola key para tu usuario local. Cuando ATLAS soporte
# múltiples usuarios (BYOK), cada usuario aportará la suya propia
# desde su configuración, no desde este archivo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Límite de gasto estimado en la API de Anthropic (Fase 28). 0 = sin tope.
# Es una ESTIMACIÓN por tabla de precios (app/core/usage.py), no la factura
# real — un guardarraíl barato contra un loop/wake-word disparando de más,
# no un medidor exacto.
ANTHROPIC_DAILY_BUDGET_USD=5.0
ANTHROPIC_MONTHLY_BUDGET_USD=0

# --- Voz (Fase 3) ---
# stt_provider: whisper (local, gratis) | mock (sin dependencias, para pruebas)
# tts_provider: edge  (voces neuronales, gratis y sin API key — NECESITA
#                      internet y el texto viaja a servidores de Microsoft)
#             | sapi  (voces de Windows: offline, pero suenan sintéticas)
#             | mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
# Tamaño del modelo Whisper: tiny | base | small | medium | large-v3
# Más grande = más preciso pero más lento/pesado. Se descarga solo la primera vez.
WHISPER_MODEL_SIZE=base
# Voz de Edge. Lista completa: python -m edge_tts --list-voices
# Hay voces para casi todos los países hispanohablantes
# (es-AR, es-CO, es-MX, es-ES, es-CL, es-PE…).
EDGE_TTS_VOICE=es-MX-JorgeNeural
# Velocidad y tono, en el formato de la propia API: "+10%", "-5%", "+0Hz".
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# --- Seguridad (Fase 7: login para clientes remotos — móvil, y ahora también escritorio) ---
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRE_MINUTES=1440
# Contraseña única de ATLAS (sistema de un solo usuario, no hay tabla de
# usuarios). Elegí una contraseña real — sin esto nadie puede loguearse.
ATLAS_PASSWORD=

# Rate limiting de /auth/login (Fase 25): tras LOGIN_MAX_ATTEMPTS fallos
# seguidos desde la misma IP, se bloquea por LOGIN_LOCKOUT_SECONDS.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Backups automáticos de la base de datos (Fase 26). Uno al arrancar y uno
# cada BACKUP_INTERVAL_HOURS mientras el proceso sigue corriendo; se
# conservan los BACKUP_KEEP_COUNT más recientes. Solo aplica a SQLite.
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=7

# --- Smart Home (Fase 5) ---
# smart_home_provider: mock (dispositivos de prueba, sin hardware real)
#                    | home_assistant
#                    | tuya  (apps de marca blanca sobre Tuya: Mercury Smart,
#                             Smart Life, Tuya Smart, Geeni…)
SMART_HOME_PROVIDER=mock
# Si usas home_assistant: URL de tu instancia (ej. http://192.168.1.50:8123
# o tu URL de Nabu Casa) y un Long-Lived Access Token (se genera desde tu
# perfil de usuario en Home Assistant, al final de la página).
SMART_HOME_URL=
SMART_HOME_TOKEN=

# --- Tuya Cloud (Fase 12) — solo si SMART_HOME_PROVIDER=tuya ---
# Pasos (gratis, sin tarjeta):
#  1. Registrate en https://iot.tuya.com → "Cloud" → "Create Cloud Project".
#     Elegí el data center de TU región (el mismo país que usaste en la app).
#  2. En el proyecto → "Overview" → copiá Access ID y Access Secret.
#  3. En el proyecto → pestaña "Devices" → "Link App Account" → "Add App
#     Account" → escaneá el QR con la app Mercury Smart / Tuya Smart.
#  4. Corré `python scripts/tuya_setup.py` — te encuentra el UID solo,
#     valida las credenciales y lista tus dispositivos.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Data center: us=https://openapi.tuyaus.com  eu=https://openapi.tuyaeu.com
#              cn=https://openapi.tuyacn.com  in=https://openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaus.com
# Lo completa por vos scripts/tuya_setup.py
TUYA_UID=

# --- Visión (Fase 8) ---
# vision_provider: mock (sin costo, para pruebas) | anthropic (real, usa la
# misma ANTHROPIC_API_KEY de arriba — Claude ya es multimodal).
VISION_PROVIDER=mock

# --- Integraciones externas (Fase 10) ---
# Wikipedia y clima (Open-Meteo) no necesitan key, funcionan siempre.
#
# YouTube: gratis. En https://console.cloud.google.com → crear proyecto →
# "APIs & Services" → habilitar "YouTube Data API v3" → "Credentials" →
# "Create credentials" → API key.
YOUTUBE_API_KEY=
#
# Spotify: gratis, sin tarjeta. En https://developer.spotify.com/dashboard
# → "Create app" (el Redirect URI puede ser cualquiera, ej.
# http://127.0.0.1:8000, no se usa en este flujo) → copiar Client ID y
# Client Secret. Solo permite buscar canciones, no controlar reproducción
# (eso necesitaría login de tu cuenta + Spotify Premium).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
#
# AudD (reconoce canciones sonando, tipo Shazam): gratis, sin tarjeta, en
# https://dashboard.audd.io/ → registrate → el token está en el dashboard
# apenas entrás ("Your API token").
AUDD_API_TOKEN=

# --- Personalización (Fase 11) ---
# Nombre para el saludo del dashboard ("¡Hola, X!"). Si lo dejás vacío, el
# saludo es genérico ("¡Hola!") en vez de inventar un nombre.
ATLAS_USER_NAME=

# Palabra de activación por voz, compartida por los tres clientes
# (escritorio, dashboard y PWA). Conviene que sea corta y sin sonidos
# ambiguos para el español: "Vision" falló porque Whisper, forzado a
# español, no reconocía su pronunciación inglesa.
ATLAS_WAKE_WORD=ali

# --- Búsqueda web (Fase 19) ---
# duckduckgo: sin API key ni registro, funciona al instante. Vía no oficial:
#             puede limitar por frecuencia o romperse sin aviso.
# tavily:     mejores resultados y una respuesta ya sintetizada. Cuenta gratis
#             en https://tavily.com (1.000 consultas/mes).
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# --- Google Calendar (Fase 21) + Gmail (Fase 23) ---
# Gratis, misma cuenta y credenciales para las dos. Pasos completos en el
# docstring de scripts/google_calendar_setup.py:
#  1. console.cloud.google.com → crear proyecto → habilitar "Google Calendar
#     API" Y "Gmail API".
#  2. "Credentials" → "Create credentials" → "OAuth client ID" → "Desktop app".
#  3. Copiá Client ID y Client Secret acá abajo.
#  4. Corré `python scripts/google_calendar_setup.py` — abre el navegador,
#     pide el consentimiento (Calendar + Gmail juntos) una sola vez y te da
#     el GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# "primary" = el calendario principal de la cuenta. Cambiar solo si querés
# que ATLAS use otro calendario (su ID está en Configuración → "Integrar
# calendario" dentro de Google Calendar).
GOOGLE_CALENDAR_ID=primary

# --- Push notifications reales (Fase 22, Web Push/VAPID) ---
# Sin cuenta externa: corré `python scripts/generate_vapid_keys.py` y
# pegá acá las dos líneas que imprime.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto real — lo exige el protocolo VAPID.
VAPID_CONTACT_EMAIL=
