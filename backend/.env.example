# ============================================================
# ATLAS backend — configuración de entorno
# Copia este archivo a ".env" en la misma carpeta y completa
# los valores. NUNCA subas ".env" al repositorio.
# ============================================================

# Entorno de la app: development | production
APP_ENV=development

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Base de datos ---
# V1 usa SQLite por defecto (cero configuración). Para migrar a
# PostgreSQL más adelante, cambia esta URL, ej:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/atlas
DATABASE_URL=sqlite:///./atlas.db

# --- Redis (reservado, no usado todavía en V1) ---
# Se activará cuando el sistema necesite sesiones/caché/tareas/eventos.
REDIS_URL=redis://localhost:6379/0

# --- Proveedor de IA ---
# anthropic | mock
# "mock" permite correr y probar ATLAS sin gastar créditos ni tener API key.
AI_PROVIDER=mock

# Key de Anthropic (solo necesaria si AI_PROVIDER=anthropic).
# En V1 es una sola key para tu usuario local. Cuando ATLAS soporte
# múltiples usuarios (BYOK), cada usuario aportará la suya propia
# desde su configuración, no desde este archivo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Voz (Fase 3) ---
# stt_provider: whisper (local, gratis) | mock (sin dependencias, para pruebas)
# tts_provider: sapi (voces de Windows, gratis) | mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
# Tamaño del modelo Whisper: tiny | base | small | medium | large-v3
# Más grande = más preciso pero más lento/pesado. Se descarga solo la primera vez.
WHISPER_MODEL_SIZE=base

# --- Seguridad (Fase 7: login para clientes remotos — móvil, y ahora también escritorio) ---
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRE_MINUTES=1440
# Contraseña única de ATLAS (sistema de un solo usuario, no hay tabla de
# usuarios). Elegí una contraseña real — sin esto nadie puede loguearse.
ATLAS_PASSWORD=
# Login: true (pide contraseña) | false (sin login — cualquiera en tu WiFi
# puede usar ATLAS y controlar esta PC). Reinicia el backend al cambiarlo.
AUTH_ENABLED=true

# --- Smart Home (Fase 5) ---
# smart_home_provider: mock (dispositivos de prueba, sin hardware real) | home_assistant
SMART_HOME_PROVIDER=mock
# Si usas home_assistant: URL de tu instancia (ej. http://192.168.1.50:8123
# o tu URL de Nabu Casa) y un Long-Lived Access Token (se genera desde tu
# perfil de usuario en Home Assistant, al final de la página).
SMART_HOME_URL=
SMART_HOME_TOKEN=

# --- Visión (Fase 8) ---
# vision_provider: mock (sin costo, para pruebas) | anthropic (real, usa la
# misma ANTHROPIC_API_KEY de arriba — Claude ya es multimodal).
VISION_PROVIDER=mock

# --- Solo mi voz (verificación de hablante del cliente Electron) ---
# Modelo: python scripts/download_speaker_model.py (26 MB, a .cache/speaker/).
# Vacío = rutas por defecto. La huella es un vector, nunca audio, y no va a git.
SPEAKER_MODEL_PATH=
SPEAKER_PROFILE_PATH=

# --- Mundo (Gods Eye View, consola geoespacial local) ---
# URL del servicio en integrations/gods-eye-view (ver docs/gods-eye-view-integration.md).
# Dejalo vacío para quitarle a ATLAS las herramientas de mundo.
GODS_EYE_URL=http://127.0.0.1:4173

# --- Briefing diario ---
# Lugar para el clima del briefing (ej. HOME_PLACE=Buenos Aires, Argentina). Vacío = sin clima.
HOME_PLACE=
# Hora a la que el briefing llega solo como notificación (HH:MM). Vacío = solo cuando lo pedís.
BRIEFING_TIME=

# --- Internet (web_search / read_web_page) ---
# false le quita a ATLAS el acceso a internet.
WEB_ENABLED=true
# Clave de la API de Brave Search (https://brave.com/search/api, tiene plan gratis). Sin clave se
# usa DuckDuckGo, que suele bloquear a los programas; ahí solo queda Wikipedia.
BRAVE_API_KEY=

# ---------- Creatividad: imágenes y dibujos ----------
# Motor por defecto para imágenes realistas: auto | openai | pollinations.
# auto = OpenAI si hay OPENAI_API_KEY, si no Pollinations (gratis, sin clave; el texto
# de la imagen se envía a pollinations.ai y la imagen sale con su marca de agua).
IMAGE_DEFAULT_ENGINE=auto
# Clave de OpenAI (https://platform.openai.com/api-keys). Cada imagen se cobra aparte.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (más calidad = más caro y más lento).
OPENAI_IMAGE_QUALITY=medium
# Modelo de Claude que dibuja ilustraciones vectoriales (SVG). Usa la misma ANTHROPIC_API_KEY.
CREATIVE_MODEL=claude-opus-5-5
# Carpeta de las creaciones. Vacío = tu carpeta Imágenes\ATLAS.
CREATIVE_DIR=
