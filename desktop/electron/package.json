{
  "name": "atlas-holographic-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"npm:electron\"",
    "electron": "wait-on tcp:5173 && electron . --dev-server=http://localhost:5173",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview",
    "predev": "node scripts/setup-mediapipe.mjs --offline && node scripts/setup-vad.mjs",
    "prebuild": "node scripts/setup-mediapipe.mjs --offline && node scripts/setup-vad.mjs",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "setup:vad": "node scripts/setup-vad.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.atlas.neuralcore",
    "productName": "ATLAS",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json", "!node_modules/**"],
    "extraResources": [
      { "from": "bundle/python", "to": "python" },
      { "from": "bundle/backend", "to": "backend" },
      { "from": "bundle/models", "to": "models" }
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ATLAS"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@react-three/fiber": "^9.0.0",
    "@types/three": "^0.180.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
