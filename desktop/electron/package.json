{
  "name": "atlas-holographic-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"npm:electron\"",
    "electron": "wait-on tcp:5173 && electron .",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview",
    "predev": "node scripts/setup-mediapipe.mjs --offline",
    "prebuild": "node scripts/setup-mediapipe.mjs --offline",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@react-three/fiber": "^9.0.0",
    "@types/three": "^0.180.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^40.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
